#!/usr/bin/env sh

set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
DEFAULT_SOCKET_PATH="$(node -e "process.stdout.write(require(process.argv[1]).socketPath)" "$SCRIPT_DIR/config.js")"
SOCKET_PATH="${LOFICLAUDE_SOCKET_PATH:-$DEFAULT_SOCKET_PATH}"

if ! command -v socat >/dev/null 2>&1; then
  echo "socat is required. Install it first (e.g. brew install socat)." >&2
  exit 1
fi

if [ ! -S "$SOCKET_PATH" ]; then
  echo "Socket not found at $SOCKET_PATH" >&2
  echo "Start bridge first: node bridge/index.js" >&2
  exit 1
fi

echo "Connecting to $SOCKET_PATH"
exec socat - UNIX-CONNECT:"$SOCKET_PATH"
